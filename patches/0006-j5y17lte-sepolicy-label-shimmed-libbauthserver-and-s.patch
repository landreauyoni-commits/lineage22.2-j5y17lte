From 3f0aeeb6fc72046b024ece8b4d7edd0f2f5c0269 Mon Sep 17 00:00:00 2001
From: landreauyoni <landreauyoni@gmail.com>
Date: Tue, 3 Nov 2026 22:54:24 +0000
Subject: [PATCH 6/7] j5y17lte: sepolicy: label shimmed libbauthserver and
 source-built NFC HAL

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01RJQhdtPqbwrS7b75MNooSf
---
 BoardConfig.mk                 | 1 +
 sepolicy/vendor/file_contexts  | 5 +++++
 sepolicy/vendor/linker_shim.te | 5 +++++
 3 files changed, 11 insertions(+)
 create mode 100644 sepolicy/vendor/file_contexts
 create mode 100644 sepolicy/vendor/linker_shim.te

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 8a8a39f..9dda693 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -104,6 +104,7 @@ TARGET_LD_SHIM_LIBS += \
 
 # Sepolicy
 SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private
+BOARD_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
 
 # Wifi
 BOARD_WLAN_DEVICE                := bcmdhd
diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
new file mode 100644
index 0000000..8b91353
--- /dev/null
+++ b/sepolicy/vendor/file_contexts
@@ -0,0 +1,5 @@
+# Shimmed vendor library libbauthserver (LD_SHIM_LIBS target, linker probes it in every domain)
+/vendor/lib(64)?/libbauthserver\.so                     u:object_r:vendor_public_lib_file:s0
+
+# Source-built NFC HAL (hardware/samsung/nfc)
+/(vendor|system/vendor)/bin/hw/android\.hardware\.nfc@1\.2-service\.samsung            u:object_r:hal_nfc_default_exec:s0
diff --git a/sepolicy/vendor/linker_shim.te b/sepolicy/vendor/linker_shim.te
new file mode 100644
index 0000000..39964b0
--- /dev/null
+++ b/sepolicy/vendor/linker_shim.te
@@ -0,0 +1,5 @@
+# The dynamic linker runs parse_LD_SHIM_LIBS in every process and probes each
+# LD_SHIM_LIBS target with access(R_OK) + realpath(); core domains never load
+# the shimmed lib, so dontaudit the probe (a grant would hit the full-Treble
+# neverallow on vendor_file_type).
+dontaudit coredomain vendor_public_lib_file:file { read getattr };
-- 
